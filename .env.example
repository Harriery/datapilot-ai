# Billing safety: fail closed.
# FREE_ONLY blocks every external provider unless it is explicitly
# listed in AI_FREE_PROVIDER_ALLOWLIST. Paid fallback stays disabled.
AI_FREE_ONLY=true
AI_FREE_PROVIDER_ALLOWLIST=nvidia,groq,google
AI_ALLOW_PAID_PROVIDER=false

# FREE_ONLY mentor runtime.
# Mentor reasoning and learning-evidence classification use GPT-OSS 120B on Groq.
# Translation and Practice generation stay on GPT-OSS 20B unless explicitly overridden.
AI_MENTOR_PROVIDER=groq
AI_CLASSIFIER_PROVIDER=groq
AI_GROQ_MENTOR_MODEL=openai/gpt-oss-120b
AI_GROQ_CLASSIFIER_MODEL=openai/gpt-oss-120b
AI_GROQ_TRANSLATOR_MODEL=openai/gpt-oss-20b
AI_GROQ_PRACTICE_GENERATOR_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# Local hard stops for every external AI request.
# Keep these conservative while DataPilot is in development.
AI_DAILY_REQUEST_LIMIT=120
AI_MONTHLY_REQUEST_LIMIT=1500
AI_MAX_INPUT_CHARS_PER_REQUEST=200000
AI_MAX_OUTPUT_TOKENS_PER_REQUEST=1500

# Legacy paid baseline. With the defaults above this key is NOT used
# because OpenAI is not in the free-provider allowlist and paid access
# is disabled.
OPENAI_API_KEY=
